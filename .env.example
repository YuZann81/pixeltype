# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# P2R API Base URL for PixelType.
#
# This is the EXACT prefix the browser calls for API endpoints, used verbatim.
# It must NOT end in /v1 when the host rewrites /api/p2r/<rest> -> /p2r/v1/<rest>
# (the Vite dev proxy and the P2R nginx proxy both do), or requests would go to
# /p2r/v1/v1/... and 404.
#
# Local development: the Vite dev proxy handles this, so no CORS is involved.
# Production: the hosting rewrite must map this prefix onto the API.
VITE_P2R_API_BASE_URL="/api/p2r"

# -----------------------------------------------------------------------------
# P2R Game Runtime Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT/VITE)
# -----------------------------------------------------------------------------
# Canonical P2R Core API v1 base URL for server-side token exchange
P2R_API_BASE_URL="https://pameran.devsaka.id/api/v1"

# Registered game slug in P2R platform
P2R_GAME_SLUG="pixeltype"

# Game runtime platform ('web', 'desktop', 'mobile')
P2R_PLATFORM="web"

# Provisioned Client ID from P2R Admin / Game Credentials
P2R_CLIENT_ID="p2r_game_kl2v23gdcwser5ra"

# Provisioned Client Secret (KEEP SECRET - Server-side only)
P2R_CLIENT_SECRET="your_p2r_client_secret_here"

